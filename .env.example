DB_HOST = localhost
DB_PORT = 5432
DB_NAME = fitness_performance_tracker
DB_USER = postgres
DB_PASSWORD = YOUR_PASSWORD


LOG_LEVEL=INFO
# Optional rotating file output (relative to the process working directory).
