JWT_SECRET_KEY=YOUR_JWT_SECURITY_KEY_THAT_HAS_TO_BE_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
